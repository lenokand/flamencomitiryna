---
import { content, settings, schedule, type Lang } from '../data/site';
import '../styles/global.css';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
export function getStaticPaths() { return [{params:{lang:undefined}}, {params:{lang:'ru'}}]; }
const lang: Lang = Astro.params.lang === 'ru' ? 'ru' : 'de';
const dayName = new Intl.DateTimeFormat(lang, {weekday:'long', timeZone:'UTC'}).format(new Date(Date.UTC(2026,9,18+schedule.weekday)));
const t = {...content[lang], title:lang === 'de' ? 'Flamenco in Bern – kostenlos tanzen mit Iryna' : 'Фламенко в Берне — бесплатные занятия с Ириной', monday:dayName, scheduleNote:schedule.notice[lang], classTitle:lang === 'de' ? 'Wann, wo und wie mitmachen?' : 'Когда, где и как присоединиться?', description:lang === 'de' ? `Flamenco mit Iryna in Bern. Kostenloser Unterricht: ${dayName}, ${settings.time}. ${settings.venue}, ${settings.address}. Aktuelle Änderungen in WhatsApp.` : `Фламенко с Ириной в Берне. Бесплатные занятия: ${dayName}, ${settings.time}. ${settings.venue}, ${settings.address}. Изменения — в WhatsApp.`};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}/${path}`;
const canonical = new URL(url(lang === 'de' ? '' : 'ru/'), Astro.site);
const other = lang === 'de' ? 'ru' : 'de';
const schema = {'@context':'https://schema.org','@graph':[
 {'@type':'WebSite','@id':new URL(url('#website'),Astro.site).href,name:settings.name,url:new URL(url(''),Astro.site).href,inLanguage:['de','ru']},
 {'@type':'WebPage',name:t.title,description:t.description,url:canonical.href,inLanguage:lang,about:{'@type':'Course',name:lang==='de'?'Kostenloser Flamenco-Unterricht in Bern':'Бесплатные занятия фламенко в Берне',description:t.description,provider:{'@type':'Organization',name:settings.name,url:new URL(url(''),Astro.site).href},isAccessibleForFree:true}}
]};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t.title}</title><meta name="description" content={t.description} />
  <meta name="theme-color" content="#181918" /><link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="de" href={new URL(url(''), Astro.site)} />
  <link rel="alternate" hreflang="ru" href={new URL(url('ru/'), Astro.site)} />
  <link rel="alternate" hreflang="x-default" href={new URL(url(''), Astro.site)} />
  <meta property="og:title" content={t.title} /><meta property="og:description" content={t.description} />
  <meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'ru_RU'} />
  <meta property="og:image" content={new URL(url('media/social.jpg'), Astro.site)} />
  <meta name="robots" content="index,follow,max-image-preview:large" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={t.portraitAlt} /><meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <meta
    name="google-site-verification"
    content="kbkeD3uZkBM3gtu64NPABRzdu37lUwMzxFVpaxQVr2Q"
  />
</head>
<body id="top">
<a class="skip" href="#main">{t.skip}</a>
<header class="header wrap">
  <a class="brand" href={url(lang === 'de' ? '' : 'ru/')} aria-label={settings.name}>flamenco<span>mit Iryna <i>·</i> Bern</span></a>
  <nav aria-label={lang === 'de' ? 'Hauptnavigation' : 'Основная навигация'}>{t.nav.map((label,i)=><a href={`#${['classes','participate','iryna','videos'][i]}`}>{label}</a>)}</nav>
  <div class="languages" aria-label={lang === 'de' ? 'Sprache' : 'Язык'}><a class:list={{active:lang==='de'}} aria-current={lang==='de'?'page':undefined} href={url('')} lang="de">DE</a><span>/</span><a class:list={{active:lang==='ru'}} aria-current={lang==='ru'?'page':undefined} href={url('ru/')} lang="ru">RU</a></div>
</header>
<main id="main" tabindex="-1">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow">{t.eyebrow}</p><h1 id="hero-title">{t.hero[0]}<br />{t.hero[1]}<br /><em>{t.hero[2]}</em></h1><p class="intro">{t.intro}</p><dl class="hero-meta" aria-label={lang === 'de' ? 'Unterricht auf einen Blick' : 'Главное о занятиях'}><div><dt>{lang === 'de' ? 'Wann' : 'Когда'}</dt><dd>{t.monday} <strong>{settings.time}</strong></dd></div><div><dt>{lang === 'de' ? 'Wo' : 'Где'}</dt><dd>{settings.venue}<span>{settings.address}</span></dd></div><div><dt>{lang === 'de' ? 'Kosten' : 'Стоимость'}</dt><dd>{t.free}</dd></div></dl><p class="hero-schedule-note">{schedule.status === 'paused' ? (lang === 'de' ? 'Der Unterricht pausiert. Aktuelle Informationen in WhatsApp.' : 'Занятия приостановлены. Актуальная информация — в WhatsApp.') : (lang === 'de' ? 'Bitte den Termin vor dem Besuch in WhatsApp bestätigen.' : 'Перед посещением уточни актуальный день занятия в WhatsApp.')}</p><div class="actions"><a class="button whatsapp-button" href={settings.whatsapp}><WhatsAppIcon />{t.join}<span aria-hidden="true">↗</span></a><a class="text-link" href="#classes">{t.discover} ↓</a></div></div>
    <div class="hero-art"><div class="halo" aria-hidden="true"></div><span class="art-word" aria-hidden="true">compás</span><img src={url('media/iryna-hero.webp')} srcset={`${url('media/iryna-hero-small.webp')} 520w, ${url('media/iryna-hero.webp')} 1000w`} sizes="(max-width: 700px) 90vw, 48vw" width="1000" height="1500" alt={t.portraitAlt} fetchpriority="high" /><span class="art-caption">PASIÓN · RITMO · LIBERTAD</span></div>
    
  </section>
  <section id="classes" class="classes"><div class="section wrap"><p class="eyebrow">{t.classLabel}</p><h2>{t.classTitle}</h2><div class="class-grid"><div><p class="day">{t.monday}</p>{schedule.status === "paused" && <p class="schedule-status">{lang === "de" ? "Unterricht pausiert – aktuelle Informationen in WhatsApp." : "Занятия приостановлены — актуальная информация в WhatsApp."}</p>}<p class="time">{settings.time}</p><p class="price">{t.price}</p></div><div class="location"><h3>{settings.venue}</h3><p>{settings.address}</p><a class="text-link" href={settings.map}>{t.directions} ↗</a></div><div id="participate"><h3>{lang === "de" ? "So machst du mit" : "Как присоединиться"}</h3><a class="button whatsapp-button" href={settings.whatsapp}><WhatsAppIcon />{t.join} ↗</a><p class="small">{t.groupNote}</p></div></div><div class="map-block"><iframe src={`${settings.mapEmbed}&hl=${lang}`} title={lang === 'de' ? 'Karte: Spitalgasse 4, Bern' : 'Карта: Spitalgasse 4, Берн'} width="600" height="260" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><div><p>{settings.venue}<br />{settings.address}</p><a class="text-link" href={settings.map}>{t.directions} ↗</a></div></div><div class="calendar-actions" data-calendar data-lang={lang} hidden><details><summary>{lang === 'de' ? 'Zum Kalender hinzufügen' : 'Добавить в календарь'} <span aria-hidden="true">＋</span></summary><div class="calendar-picker"><label for="class-date">{lang === "de" ? "Termin wählen · Planung bis Weihnachten" : "Выбери дату · план до Рождества"}</label><select id="class-date" data-class-date>{schedule.dates.map(day=><option value={day}>{new Intl.DateTimeFormat(lang,{day:"numeric",month:"long",timeZone:"UTC"}).format(new Date(`${day}T12:00:00Z`))} · {schedule.startTime}–{schedule.endTime}</option>)}</select><p data-calendar-date aria-live="polite"></p></div><div class="calendar-options"><a data-google target="_blank" rel="noopener noreferrer">Google Calendar ↗</a><a data-ics download="flamenco-iryna.ics">Apple / Outlook (.ics) ↓</a></div></details><small>{lang === 'de' ? 'Ein einzelner Termin. Bitte Änderungen vor dem Besuch in WhatsApp prüfen.' : 'Одно занятие. Перед посещением проверь изменения в WhatsApp.'}</small></div><p class="notice">{t.scheduleNote}</p></div></section>
  <section id="flamenco" class="philosophy section wrap"><p class="eyebrow">{t.philosophyLabel}</p><div class="split"><h2>{t.philosophyTitle}</h2><div><p class="large-copy">{t.philosophy}</p><p class="muted">{t.philosophyEnd}</p></div></div><div class="rhythm" aria-hidden="true"><span>FUERZA</span><i>✳</i><span>ALMA</span><i>✳</i><span>LIBERTAD</span></div></section>
  <section id="iryna" class="about section wrap"><div class="portrait"><img src={url('media/iryna-portrait.webp')} width="900" height="900" loading="lazy" alt={lang === 'de' ? 'Iryna mit einem blauen Fächer' : 'Ирина с синим веером'} /><span class="portrait-mark" aria-hidden="true">Iryna</span></div><div class="about-copy"><p class="eyebrow">{t.aboutLabel}</p><h2>{t.aboutTitle}</h2><p>{t.about}</p><p class="muted">{t.aboutEnd}</p><blockquote>«{t.quote}»<cite>— Iryna</cite></blockquote></div></section>
  <section id="videos" class="section wrap"><p class="eyebrow">{t.galleryLabel}</p><div class="section-heading"><h2>{t.galleryTitle}</h2><p class="muted">{t.galleryIntro}</p></div><div class="video-grid">{t.videos.map((title,i)=><article class="video-card"><div class="video-frame"><video id={`video-${i}`} controls playsinline preload="none" poster={url(`media/video-${i+1}.jpg`)} aria-label={title}><source src={url(`media/video-${i+1}.mp4`)} type="video/mp4" /><a href={url(`media/video-${i+1}.mp4`)}>{t.videoFallback}</a></video></div><div class="video-title"><span>0{i+1}</span><h3>{title}</h3></div><div class="video-tools"><label>{t.speed} <select data-speed={`video-${i}`} aria-label={`${t.speed}: ${title}`}><option value="0.5">0.5×</option><option value="0.75">0.75×</option><option value="1" selected>1×</option></select></label><label><input type="checkbox" data-loop={`video-${i}`} /> {t.loop}</label></div></article>)}</div></section>
  <section id="practice" class="practice section wrap"><p class="eyebrow">{t.learnLabel}</p><h2>{t.learnTitle}</h2><div class="cards">{t.cards.map((card,i)=><article><span class="card-number">0{i+1}</span><p class="eyebrow">{card.tag}</p><h3>{card.title}</h3><p>{card.text}</p></article>)}</div></section>
  <section class="workshop section wrap"><div><p class="eyebrow">{t.workshopLabel}</p><h2>{t.workshopTitle}</h2></div><div><p>{t.workshop}</p><p class="muted small">{t.workshopNote}</p><a class="text-link whatsapp-link" href={settings.whatsapp}><WhatsAppIcon />{t.join} ↗</a></div></section>
  <section class="faq section wrap"><p class="eyebrow">FAQ</p><h2>{lang === 'de' ? 'Gut zu wissen.' : 'Полезно знать.'}</h2>{(lang === 'de' ? [
 ['Was kostet die Teilnahme?','Die Teilnahme ist kostenlos.'],['Wie kann ich mitmachen?',t.groupNote],['Sind alle Termine bestätigt?',schedule.notice.de],['Wo findet der Unterricht statt?',`${settings.venue}, ${settings.address}.`]
 ] : [['Сколько стоят занятия?','Участие бесплатное.'],['Как присоединиться?',t.groupNote],['Все даты подтверждены?',schedule.notice.ru],['Где проходят занятия?',`${settings.venue}, ${settings.address}.`]]).map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section><section class="closing wrap"><p>{t.closing}</p><a class="whatsapp-link" href={settings.whatsapp} aria-label={t.join}><WhatsAppIcon /></a></section>
</main><a class="back-to-top" href="#top" aria-label={t.top}><span aria-hidden="true">↑</span></a>
<footer class="wrap"><div class="footer-top"><a class="brand" href="#top">flamenco<span>mit Iryna · Bern</span></a><div class="thanks"><a class="montagscafe-badge" href={settings.montagscafe} target="_blank" rel="noopener noreferrer"><span>{lang === "de" ? "Mit Unterstützung des" : "При поддержке"}</span><strong>Montagscafé <span aria-hidden="true">↗</span></strong></a><small>{t.independent}</small></div><a href="#top">{t.top} ↑</a></div><p class="privacy">{t.privacy}</p><div class="footer-bottom"><span>© {new Date().getFullYear()} {settings.name}</span><a href={url(other==='de'?'':'ru/')} lang={other}>{other==='de'?'Deutsch':'Русский'} ↗</a></div></footer>
<script>
 import { schedule, settings } from '../data/site';
 import { nextClass, calendarLinks, zonedInstant } from '../lib/calendar';
 const calendar = document.querySelector<HTMLElement>('[data-calendar]');
 let calendarBlob: string | undefined;
 const dateSelect=document.querySelector<HTMLSelectElement>('[data-class-date]');
 let selectedDate='';
 dateSelect?.addEventListener('change',()=>{selectedDate=dateSelect.value;updateCalendar();});
 function updateCalendar() {
  if (!calendar) return;
  const next=nextClass(schedule);
 if(dateSelect) for(const option of dateSelect.options) option.disabled=zonedInstant(option.value,schedule.startTime,schedule.timeZone)<=new Date() || (schedule.excludedDates as string[]).includes(option.value);
 const event = schedule.status==='paused' ? null : (selectedDate && zonedInstant(selectedDate,schedule.startTime,schedule.timeZone)>new Date() && !(schedule.excludedDates as string[]).includes(selectedDate) ? {day:selectedDate,start:zonedInstant(selectedDate,schedule.startTime,schedule.timeZone),end:zonedInstant(selectedDate,schedule.endTime,schedule.timeZone)} : next);
 if(event && dateSelect)dateSelect.value=event.day; calendar.hidden = !event;
  if (!event) return;
  const lang = calendar.dataset.lang === 'ru' ? 'ru' : 'de';
  const description = `${schedule.notice[lang]}\n${settings.whatsapp}`;
  const links = calendarLinks(schedule,event,settings.name,description);
  calendar.querySelector('[data-calendar-date]')!.textContent = `${lang === 'de' ? 'Gewählter geplanter Termin' : 'Выбранная плановая дата'}: ${new Intl.DateTimeFormat(lang,{dateStyle:'long',timeZone:schedule.timeZone}).format(event.start)} · ${schedule.startTime}–${schedule.endTime}`;
  calendar.querySelector<HTMLAnchorElement>('[data-google]')!.href = links.google;
  if (calendarBlob) URL.revokeObjectURL(calendarBlob);
  calendarBlob = URL.createObjectURL(new Blob([links.ics],{type:'text/calendar;charset=utf-8'}));
  calendar.querySelector<HTMLAnchorElement>('[data-ics]')!.href = calendarBlob;
 }
 const topLink=document.querySelector<HTMLAnchorElement>('.back-to-top');
 topLink?.addEventListener('click',()=>{document.getElementById('main')?.focus({preventScroll:true});});
 updateCalendar();
 document.addEventListener('visibilitychange',()=>{if(!document.hidden)updateCalendar();});
 calendar?.querySelector('details')?.addEventListener('toggle',updateCalendar);
 document.querySelectorAll<HTMLSelectElement>('[data-speed]').forEach(select=>select.addEventListener('change',()=>{ const video=document.getElementById(select.dataset.speed!) as HTMLVideoElement; video.playbackRate=Number(select.value); }));
 document.querySelectorAll<HTMLInputElement>('[data-loop]').forEach(input=>input.addEventListener('change',()=>{ const video=document.getElementById(input.dataset.loop!) as HTMLVideoElement; video.loop=input.checked; }));
 document.querySelectorAll('video').forEach(video=>video.addEventListener('play',()=>document.querySelectorAll('video').forEach(other=>{if(other!==video) other.pause();})));
</script>
</body></html>



